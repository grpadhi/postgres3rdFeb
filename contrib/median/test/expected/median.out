CREATE TABLE intvals(val int, color text);
-- Test empty table
SELECT median(val) FROM intvals;
 median 
--------
       
(1 row)

-- Integers with odd number of values
INSERT INTO intvals VALUES
       (1, 'a'),
       (2, 'c'),
       (9, 'b'),
       (7, 'c'),
       (2, 'd'),
       (-3, 'd'),
       (2, 'e');
SELECT * FROM intvals ORDER BY val;
 val | color 
-----+-------
  -3 | d
   1 | a
   2 | c
   2 | e
   2 | d
   7 | c
   9 | b
(7 rows)

SELECT median(val) FROM intvals;
 median 
--------
      2
(1 row)

-- Integers with NULLs and even number of values
INSERT INTO intvals VALUES
       (99, 'a'),
       (NULL, 'a'),
       (NULL, 'e'),
       (NULL, 'b'),
       (7, 'c'),
       (0, 'd');
SELECT * FROM intvals ORDER BY val;
 val | color 
-----+-------
  -3 | d
   0 | d
   1 | a
   2 | e
   2 | d
   2 | c
   7 | c
   7 | c
   9 | b
  99 | a
     | a
     | e
     | b
(13 rows)

SELECT median(val) FROM intvals;
 median 
--------
      2
(1 row)

-- Text values
CREATE TABLE textvals(val text, color int);
INSERT INTO textvals VALUES
       ('erik', 1),
       ('mat', 3),
       ('rob', 8),
       ('david', 9),
       ('lee', 2);
SELECT * FROM textvals ORDER BY val;
  val  | color 
-------+-------
 david |     9
 erik  |     1
 lee   |     2
 mat   |     3
 rob   |     8
(5 rows)

SELECT median(val) FROM textvals;
 median 
--------
 lee
(1 row)

-- Test large table with timestamps
CREATE TABLE timestampvals (val timestamptz);
INSERT INTO timestampvals(val)
SELECT TIMESTAMP 'epoch' + (i * INTERVAL '1 second')
FROM generate_series(0, 100000) as T(i);
SELECT median(val) FROM timestampvals;
            median            
------------------------------
 Thu Jan 01 13:53:20 1970 PST
(1 row)

---------------------------------------------------------------------------------
---- Added tests for data types
---------------------------------------------------------------------------------
CREATE TABLE SampleTable1
(
    ID            INT PRIMARY KEY,
    Quantity      INT,
    Price         DECIMAL(10, 2),
    Name          VARCHAR(255),
    Description   TEXT,
    IsActive      BOOLEAN,
    OrderDate     DATE,
    OrderTime     TIME,
    OrderDateTime Timestamp,
    BinaryData    bytea,
    JSONData      JSON
);
-- Populate the table with sample values
INSERT INTO SampleTable1 (ID, Quantity, Price, Name, Description, IsActive, OrderDate, OrderTime, OrderDateTime, BinaryData, JSONData)
VALUES (1, 10, 25.50, 'Product A', 'Description of Product A', TRUE, '2023-10-26', '10:00:00', '2023-10-26 10:00:00', E'0x48656C6C6F', '{"product": "A","quantity": 10}'),
       (2, 20, 50.00, 'Product B', 'Description of Product B', FALSE, '2023-10-27', '12:30:00', '2023-10-27 12:30:00', E'0x576F726C64', '{"product": "B","quantity": 20}'),
       (3, 15, 30.75, 'Product C', 'Description of Product C', TRUE, '2023-10-28', '15:45:00', '2023-10-28 15:45:00', E'0x4772656574', '{"product": "C","quantity": 15}'),
       (4, 5, 12.25, 'Product D', 'Description of Product D', FALSE, '2023-10-29', '09:15:00', '2023-10-29 09:15:00', E'0x427965', '{"product": "D","quantity": 5}'),
       (5, 25, 60.00, 'Product E', 'Description of Product E', TRUE, '2023-10-30', '14:00:00', '2023-10-30 14:00:00', E'0x4C6F72656D', '{"product": "E","quantity": 25}');
-- Calculate and display median values
-- 1.1 Quantity (INT)
SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY Quantity) AS medianQuantity FROM SampleTable1;
 medianquantity 
----------------
             15
(1 row)

select median(quantity) AS medianQuantity from SampleTable1;
 medianquantity 
----------------
             15
(1 row)

-- 1.2 Price (DECIMAL)
SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY Price) AS medianPrice FROM SampleTable1;
 medianprice 
-------------
       30.75
(1 row)

select median(Price) AS medianPrice from SampleTable1;
 medianprice 
-------------
       30.75
(1 row)

-- 1.3 Name (VARCHAR)
SELECT Name as medianName FROM SampleTable1 ORDER BY Name LIMIT 1 OFFSET (SELECT COUNT(Name) FROM SampleTable1) / 2;
 medianname 
------------
 Product C
(1 row)

select median(Name) as medianName from SampleTable1;
 medianname 
------------
 Product C
(1 row)

-- 1.4 Description (TEXT) 
SELECT Description as medianDescription FROM SampleTable1 ORDER BY Description LIMIT 1 OFFSET (SELECT COUNT(Description) FROM SampleTable1) / 2;
    mediandescription     
--------------------------
 Description of Product C
(1 row)

select median(Description) as medianDescription from SampleTable1;
    mediandescription     
--------------------------
 Description of Product C
(1 row)

-- 1.5 IsActive (BOOLEAN) - Median is not very useful
select median(IsActive) as medianIsActive from SampleTable1;
ERROR:  Computing Median is not supported on boolean data type.
-- 1.6 OrderDate (DATE)
SELECT OrderDate as medianOrderDate FROM SampleTable1 ORDER BY Name LIMIT 1 OFFSET (SELECT COUNT(OrderDate) FROM SampleTable1) / 2;
 medianorderdate 
-----------------
 10-28-2023
(1 row)

select median(OrderDate) as medianOrderDate from SampleTable1;
 medianorderdate 
-----------------
 10-28-2023
(1 row)

-- 1.7 OrderTime (TIME)
select median(OrderTime) AS medianOrderTime from SampleTable1;
 medianordertime 
-----------------
 12:30:00
(1 row)

-- 1.8 OrderDateTime (TIMESTAMP)
select median(OrderDateTime) as medianOrderDateTime from SampleTable1;
   medianorderdatetime    
--------------------------
 Sat Oct 28 15:45:00 2023
(1 row)

-- 1.9 BinaryData (BYTEA) - Median isn't directly applicable.
select median(BinaryData) as medianBinaryData from SampleTable1;
ERROR:  Computing Median is not supported on bytea data type.
-- 1.10 JSONData (JSON) - Median isn't directly applicable.
select median(JSONData) as medianJSONData from SampleTable1;
ERROR:  Computing Median is not supported on json data type.
-- Insert nulls into the columns and verify that the result remains same where median is supported
INSERT INTO SampleTable1 (ID, Quantity, Price, Name, Description, IsActive, OrderDate, OrderTime, OrderDateTime, BinaryData, JSONData)
VALUES (6, null, null, null, null, TRUE, null, null, null,null, null),
       (7, null, null, null, null, TRUE, null, null, null,null, null),
       (8, null, null, null, null, TRUE, null, null, null,null, null),
       (9, null, null, null, null, TRUE, null, null, null,null, null);
--- 2.1 Quantity (INT)
SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY Quantity) AS medianQuantity FROM SampleTable1;
